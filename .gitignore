# ==========================================
# Node.js / pnpm
# ==========================================
node_modules/
.pnpm-store/
pnpm-debug.log*

# ==========================================
# TypeScript / Build Outputs
# ==========================================
dist/
*.tsbuildinfo
*.js.map
*.d.ts

# ==========================================
# Environment Variables (NUNCA subir estos)
# ==========================================
.env
.env.local
.env.*.local
*.pem
*.key

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ==========================================
# IDEs and Editors (Cursor, VS Code, etc.)
# ==========================================
# Cursor specific (optional, but good to keep local settings private)
.cursor/
.cursorignore

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / WebStorm
.idea/
*.iml
*.ipr
*.iws

# ==========================================
# Testing and Evaluation Outputs
# ==========================================
# Ignore generated test results, but keep the folder structure
tests/results/*.json
tests/results/*.log
coverage/
.nyc_output/

# ==========================================
# Logs
# ==========================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ==========================================
# Temporary Files
# ==========================================
*.tmp
*.temp
*.swp
*.swo
*~