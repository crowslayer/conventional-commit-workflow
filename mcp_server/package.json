{
  "name": "conventional-commit-workflow-mcp",
  "version": "2.6.0",
  "description": "MCP server for the Conventional Commit Workflow skill",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "conventional-commit-workflow-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/crowslayer/conventional-commit-workflow.git",
    "directory": "mcp_server"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "git",
    "conventional-commits",
    "ai-agent",
    "semantic-release"
  ],
  "author": "Alexander Herrera",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "glob": "^14.0.6",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/node": "^20.19.43",
    "typescript": "^5.3.0"
  }
}
